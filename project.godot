config_version=5
[application]
config/name="Far From Home"
config/version="0.7.0"
config/description="Survive a crash on Old Mill Road, reach Blackwood, and find a way to call for rescue."
run/max_fps=60
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")
config/icon="res://icon.svg"
[display]
window/size/viewport_width=640
window/size/viewport_height=400
window/size/window_width_override=1280
window/size/window_height_override=800
window/stretch/mode="viewport"
window/stretch/scale_mode="integer"
[rendering]
renderer/rendering_method="gl_compatibility"
gl_compatibility/driver.windows="opengl3_angle"
textures/default_filters/use_nearest_mipmap_filter=false
