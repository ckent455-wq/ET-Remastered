extends SceneTree
func _initialize():call_deferred("run")
func key(g,code):
 var e=InputEventKey.new();e.keycode=code;e.pressed=true;g._unhandled_input(e)
func step(car,seconds:float):
 for frame in range(int(ceil(seconds*60))):car.update_waking(1.0/60)
func run():
 var g=load("res://main.tscn").instantiate();root.add_child(g)
 g.set_physics_process(false);g.enemies.set_physics_process(false);g.controller.set_process(false);g.town.townspeople.set_physics_process(false);g.cemetery_shadow.set_physics_process(false)
 var car=g.crash_site;car.set_process(false)
 g.reset_game()
 var panel=car.door.get_node("DriverInnerDoor")
 var slab=panel.get_child(0).get_child(0)
 var native_bounds=(car.wreck.global_transform.affine_inverse()*car.door.global_transform)*car.door.get_aabb()
 var panel_bounds=(car.wreck.global_transform.affine_inverse()*slab.global_transform)*slab.get_aabb()
 assert(native_bounds.grow(0.01).encloses(panel_bounds),"Inner panel fits the original native door instead of floating outside its outline")
 assert(panel_bounds.position.x> -0.76,"Inner liner stays behind the tapered outer door skin")
 var attachment=panel.transform
 var upper_window=car.door.get_node("DriverDoorUpperWindow")
 var window_attachment=upper_window.transform
 var windshield_shell=car.wreck.find_child("RestoredWindshieldPillars",true,false)
 assert(windshield_shell!=null and not car.door.is_ancestor_of(windshield_shell),"Windshield and painted supports belong to the fixed car body")
 var windshield_transform=windshield_shell.global_transform
 var window_bounds=(car.wreck.global_transform.affine_inverse()*upper_window.global_transform)*upper_window.get_aabb()
 assert(window_bounds.end.y>1.39,"The complete sloping window is attached above the source door cut")
 var hinge=car.door.global_position
 for angle in [0.0,-0.3,-0.7,-1.15,0.0]:
  car.door.rotation.y=car.door_closed.y+angle
  assert(panel.transform.is_equal_approx(attachment) and car.door.global_position.distance_to(hinge)<0.0001,"Door and inner trim share the fixed native hinge")
  assert(upper_window.transform.is_equal_approx(window_attachment),"Upper glass and seals stay attached throughout the door swing")
  assert(windshield_shell.global_transform.is_equal_approx(windshield_transform),"Opening the door cannot pull the windshield or pillars away from the roof")
 assert(car.body_materials.any(func(entry):return entry.material.resource_name=="CabinWindowGlass" and entry.material.albedo_color.a<0.2),"Separate transparent window surfaces")
 car.start_opening()
 assert(g.state=="waking" and car.wake_phase=="menu_fade" and g.camera.top_level)
 assert(g.camera.global_position.distance_to(car.wreck.to_global(car.DRIVER_EYE))<0.001,"Camera starts in driver seat")
 var body=g.player.global_position
 for i in range(12):g._physics_process(1.0/60)
 assert(g.player.global_position==body,"No walking while seated")
 step(car,0.9);assert(car.wake_phase=="blinking")
 assert(car.eye_opening()<0.1)
 step(car,3.2);assert(car.wake_phase=="ignition_ready" and car.ignition_attempts==0 and "START THE CAR" in car.waking_prompt())
 car.look_inside(Vector2(-10000,10000));assert(car.seat_yaw<=1.65 and car.seat_pitch>=-0.65)
 car.seat_yaw=0;car.seat_pitch=-0.05;car.update_seated_camera()
 key(g,KEY_E);assert(car.ignition_attempts==1 and car.wake_phase=="cranking" and car.starter_voice.playing)
 for i in range(10):key(g,KEY_E)
 assert(car.ignition_attempts==1,"Rapid input cannot skip attempts")
 key(g,KEY_ESCAPE);var clock=car.wake_elapsed;car._process(0.5)
 assert(g.state=="paused" and car.wake_elapsed==clock and car.starter_voice.stream_paused,"Pause freezes ignition and sound")
 g.set_state("play");step(car,1.8)
 assert(car.wake_phase=="ignition_retry" and g.state=="waking" and car.ignition_attempts==1)
 assert(not car.door_open and "AGAIN" in car.waking_prompt(),"First failed attempt prompts retry, not exit")
 g.controller.activate(0);g.controller.button(JOY_BUTTON_X)
 assert(car.ignition_attempts==2 and car.wake_phase=="cranking","Controller makes second attempt")
 step(car,1.8)
 assert(g.state=="dialogue" and car.wake_phase=="dialogue" and g.camera.top_level)
 assert("engine's dead" in g.dialogue_text and "no phone signal" in g.dialogue_text and "trunk" in g.dialogue_text)
 for i in range(g.dialogue_pages.size()):key(g,KEY_E)
 assert(g.state=="waking" and car.wake_phase=="door_ready" and not car.door_open)
 assert("DRIVER'S DOOR" in car.waking_prompt())
 key(g,KEY_E);assert(car.wake_phase=="door_opening" and car.door_open)
 step(car,0.8);assert(car.wake_phase=="exiting")
 step(car,1.55);assert(g.state=="play" and car.wake_phase=="" and not g.camera.top_level)
 assert(g.player.global_position.distance_to(car.wreck.to_global(car.EXIT_POSITION))<0.001)
 assert(g.camera.position==Vector3(0,g.STANDING_EYE,0) and not car.hatch_open and not car.has_backpack)
 await physics_frame;await physics_frame
 var query=PhysicsShapeQueryParameters3D.new();query.shape=g.player_collider.shape;query.transform=g.player_collider.global_transform;query.collision_mask=1;query.exclude=[g.player.get_rid()]
 assert(g.player.get_world_3d().direct_space_state.intersect_shape(query).is_empty(),"Exit position clears car and world colliders")
 g.camera.global_position=car.wreck.to_global(Vector3(0,1.6,3.25));g.camera.look_at(car.tutorial_areas.crash_rear_hatch.global_position)
 g.town.refresh_focus();assert(g.town.focus_action=="crash_rear_hatch")
 g.town.interact();assert(car.hatch_open)
 for id in ["crash_backpack","crash_flashlight"]:
  g.camera.look_at(car.tutorial_areas[id].global_position);await physics_frame;g.town.refresh_focus()
  assert(g.town.focus_action==id);g.town.interact()
 assert(car.tutorial_complete() and not g.weapons.owned.has(true),"Trunk gear completes tutorial without granting guns")
 g.reset_game();car.start_opening();assert(car.ignition_attempts==0 and not car.door_open)
 g.testing_mode.begin()
 assert(g.state=="play" and not g.camera.top_level and car.wake_phase=="","F10 safely exits seated camera")
 g.reset_game();assert(not g.testing_mode.enabled and car.ignition_attempts==0 and not g.camera.top_level)
 print("PASS: seated wake/blink, constrained look, two separate ignition attempts, starter audio, input debounce, pause/resume, delayed dead-engine dialogue, controller input, door opening, animated collision-safe exit, real trunk pickups, unarmed start, reset and F10 skip")
 g.queue_free();await process_frame;quit()
