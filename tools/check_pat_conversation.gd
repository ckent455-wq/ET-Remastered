extends SceneTree
func _initialize():call_deferred("run")
func press(g,key):
 var event=InputEventKey.new();event.keycode=key;event.pressed=true;g._unhandled_input(event)
func finish_answer(g,c):
 var guard=0
 while not c.choosing and guard<100:g.advance_dialogue();guard+=1
 assert(c.choosing and g.state=="dialogue","Answer returns to the question menu")
func run():
 var g=load("res://main.tscn").instantiate();root.add_child(g)
 g.set_physics_process(false);g.enemies.set_physics_process(false);g.controller.set_process(false);g.town.townspeople.set_physics_process(false)
 g.reset_game();g.crash_site.wake_phase="";g.crash_site.has_backpack=true;g.state="play"
 var people=g.town.townspeople;var c=people.conversation
 var original_view=g.camera.transform;var original_yaw=g.player.rotation.y
 people.talk("ranger")
 assert(c.active and not c.choosing and g.state=="dialogue","Pat's first introduction remains before optional questions")
 finish_answer(g,c)
 assert(g.hud.note_height(g.story.RECORDS.chapel_record[1],10)<=200,"The expanded church history stays readable within its journal page")
 c.choose(0)
 assert("Three days" in g.dialogue_text and "lose hours" in g.dialogue_text and "Aubrey" in g.dialogue_text,"Pat explains why recognizing the recording did not lead to securing the road")
 assert("Three days, not one long night" in g.story.RECORDS.ranger_note[1] and g.hud.note_height(g.story.RECORDS.ranger_note[1],10)<=200,"Dated road log corroborates the delay and fits its page")
 finish_answer(g,c)
 press(g,KEY_DOWN);press(g,KEY_ENTER)
 assert(c.current_topic=="house" and "Nine years" in g.dialogue_text and "cellar" in g.dialogue_text,"Keyboard asks about the old Victorian house")
 assert(g.town.journal_entries.any(func(entry):return entry.id=="pat_house"),"Answer is saved in the journal")
 finish_answer(g,c)
 var count=g.town.journal_entries.size();c.choose(1);finish_answer(g,c)
 assert(g.town.journal_entries.size()==count,"Repeated questions never duplicate journal entries")
 g.town.journal_entries.append({"id":"victorian_letter","title":"House clearance notice","text":"Nine years ago"})
 c.choose(1);assert("You found the notice" in g.dialogue_text,"House answer responds to finding the clearance notice")
 finish_answer(g,c)
 c.choose(c.TOPICS.size());people.talk("mechanic")
 assert(c.active and not c.choosing and g.dialogue_name=="John / Mechanic","John gets his own first introduction")
 finish_answer(g,c)
 assert(c.TOPICS.size()==3 and c.TOPICS[0].id=="church" and c.TOPICS[1].id=="stayed","John owns church and Ada questions")
 g.controller.activate(0);g.controller.button(JOY_BUTTON_A)
 assert(c.current_topic=="church" and "1891" in g.dialogue_text and "flood line" in g.dialogue_text,"Gamepad chooses John's church history")
 assert("three weeks before the evacuation" in g.dialogue_text and "tried to return" in g.dialogue_text,"John's church answer separates the early visit from his blocked return")
 for id in ["workshop_record","cellar_record"]:assert(g.hud.note_height(g.story.RECORDS[id][1],10)<=200,"Revised John records fit their journal pages: "+id)
 assert("THREE WEEKS BEFORE EVACUATION" in g.story.RECORDS.cellar_record[1] and not "Three shapes" in g.story.RECORDS.cellar_record[1],"Dated cellar sheet cannot describe later monster encounters")
 assert("two minutes later" in g.story.RECORDS.workshop_record[1] and "tried to return" in g.story.RECORDS.workshop_record[1],"Later observations remain in the workshop log")
 g.controller.button(JOY_BUTTON_B);assert(c.choosing,"Gamepad back returns from an answer")
 c.choose(1);assert("Ada took the last bus" in g.dialogue_text,"John explains his own reason for staying")
 finish_answer(g,c);c.choose(c.TOPICS.size());people.talk("nurse");finish_answer(g,c)
 assert(c.TOPICS.size()==3 and c.TOPICS[0].id=="signal" and c.TOPICS[1].id=="patients","Aubrey owns signal and patients questions")
 var click=InputEventMouseButton.new();click.button_index=MOUSE_BUTTON_LEFT;click.pressed=true;click.position=c.row(0).get_center();g._unhandled_input(click)
 assert(c.current_topic=="signal" and "I kept records" in g.dialogue_text,"Mouse chooses Aubrey's firsthand signal account")
 finish_answer(g,c);g.story.read_evidence("clinic_note");c.choose(1)
 assert("You've read my chart" in g.dialogue_text,"Clinic evidence deepens Aubrey's patient answer")
 finish_answer(g,c)
 assert(g.town.journal_entries.any(func(entry):return entry.id=="john_church" and entry.title.begins_with("John")),"John's history is attributed correctly")
 assert(g.town.journal_entries.any(func(entry):return entry.id=="aubrey_patients" and entry.title.begins_with("Aubrey")),"Aubrey's history is attributed correctly")
 press(g,KEY_ESCAPE)
 assert(g.state=="play" and not c.active and g.camera.transform.is_equal_approx(original_view) and is_equal_approx(g.player.rotation.y,original_yaw),"Leaving restores the player's view")
 people.talk("ranger");assert(c.choosing,"Later visits open directly to questions")
 assert(c.TOPICS.size()==3 and c.TOPICS[0].id=="town" and c.TOPICS[1].id=="house","Pat has only two lore questions plus advice")
 c.choose(2);assert("station key" in g.dialogue_text.to_lower(),"Advice follows the current quest")
 press(g,KEY_ESCAPE);press(g,KEY_ESCAPE)
 g.town.powered=true;g.town.inventory.coil=1
 people.talk("ranger")
 assert(people.grave_key_given and g.town.inventory.mausoleum_key==1 and "Whitcomb" in g.dialogue_text,"Mausoleum key handoff retains priority")
 assert("temporary lockup" in g.dialogue_text.to_lower() and "John asked me" in g.dialogue_text and "handed me its key" in g.dialogue_text,"Pat explains who cached each item and why")
 for id in ["cemetery_note","cellar_note"]:assert(g.hud.note_height(g.town.actions[id].text,10)<=200,"Cache explanation fits note: "+id)
 finish_answer(g,c);c.choose(c.TOPICS.size())
 people.talk("ranger");assert(g.town.inventory.mausoleum_key==1,"Questions cannot duplicate quest keys")
 c.choose(c.TOPICS.size());people.talk("nurse")
 assert(g.state=="dialogue" and c.active and c.choosing and g.dialogue_name=="Aubrey / Nurse","Aubrey remembers her own greeting after talking to Pat")
 g.set_state("play");people.characters.ranger.dead=true;people.talk("ranger")
 assert(g.state=="play" and not c.active,"Dead Pat cannot open a conversation")
 g.reset_game();assert(not c.active and not c.greeted and c.greetings.is_empty() and c.asked.is_empty() and not g.town.journal_entries.any(func(entry):return entry.id.begins_with("pat_")),"New journey clears conversation history and notes")
 print("PASS: three distinct NPC question menus, keyboard/mouse/controller, lore continuity, evidence-aware answers, deduplicated journal, view restore, quest advice, key handoff, other NPCs, death and reset")
 g.queue_free();await process_frame;quit()
